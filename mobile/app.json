{
  "expo": {
    "name": "L-ARTIS",
    "slug": "lartis",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF9F6"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#FFFFFF",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "icon": "./assets/logo.png",
      "package": "com.marc2.lartis",
      "versionCode": 4,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "lartis",
              "host": "reinitialiser-mot-de-passe"
            },
            {
              "scheme": "lartis",
              "host": "verification-email"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-mark.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAF9F6"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "L-ARTIS accède à vos images pour illustrer vos réalisations.",
          "cameraPermission": "L-ARTIS utilise l'appareil photo pour photographier vos réalisations."
        }
      ]
    ],
    "scheme": "lartis"
  }
}
