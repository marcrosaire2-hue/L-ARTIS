# =====================================================
# ARTISANS MARKETPLACE — Variables d'environnement
# Copier ce fichier en `.env` et adapter les valeurs
# =====================================================

# --- Serveur ---
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
# Deep links app native (expo scheme). Doit se terminer par ://
APP_DEEP_LINK_BASE=lartis://
# Aperçu web Expo (développement uniquement)
MOBILE_WEB_URL=http://localhost:8081

# --- Base de données MongoDB ---
MONGODB_URI=mongodb://127.0.0.1:27017/artisans-marketplace

# --- Sécurité ---
JWT_SECRET=change-me-avec-une-chaine-aleatoire-tres-longue
JWT_REFRESH_SECRET=change-me-avec-une-autre-chaine-aleatoire
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=artisans-marketplace-api
BCRYPT_ROUNDS=12

# --- Cookies ---
COOKIE_SECURE=false

# --- Email (SMTP — Gmail : mot de passe d'application) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre.email@gmail.com
SMTP_PASS=
SMTP_FROM="L-ARTIS <votre.email@gmail.com>"

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX=20

# --- Uploads (Cloudinary) ---
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
MAX_FILE_SIZE_MB=5
